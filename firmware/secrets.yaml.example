# Vorlage für secrets.yaml (NICHT committen). Gilt für ALLE Geräte gemeinsam.
# Das Dashboard-Backend legt secrets.yaml beim Start SELBST an und pflegt sie
# (Administration -> MQTT-Broker -> Firmware-Secrets). Von Hand kopieren nur,
# wenn esphome ohne Dashboard rein per CLI genutzt wird.

# MQTT-Broker in der Halle (= LAN-IP des Dashboard-PCs bei eingebettetem Broker)
mqtt_broker: "192.168.1.10"
mqtt_user: "gas"
mqtt_password: "CHANGE_ME"

# OTA-Passwort (für Firmware-Updates über Ethernet)
ota_password: "CHANGE_ME_OTA"

# API-Verschlüsselung (32-Byte Base64). Neu erzeugen mit:
#   openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32BYTE_KEY"
